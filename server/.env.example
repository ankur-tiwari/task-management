# Copy to .env and fill in. The server refuses to start with missing/weak secrets.
NODE_ENV=development
PORT=4000
# Exact browser origin allowed by CORS/CSRF (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/tasks.db

# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# 32 bytes as 64 hex chars. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# Set to the number of reverse proxies in front of the app (0 = none)
TRUST_PROXY=0
